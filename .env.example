# MySQL
MYSQL_ROOT_PASSWORD=change-me-please
DB_NAME=jira_db
DB_USER=jira_user
DB_PASSWORD=change-me-please

# Admin login for the UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Fernet key (32 bytes, base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE-WITH-FERNET-KEY=

# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-WITH-JWT-SECRET
